{
  "manifest_version": 3,
  "name": "DO Notes Clipper",
  "short_name": "DO Notes",
  "version": "1.0",
  "description": "Save a page, a selection or a picture to the Inbox in DO Notes.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Save to DO Notes", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "permissions": ["activeTab", "contextMenus", "scripting", "storage", "nativeMessaging"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Save to DO Notes" } }
}
